# Server Port
PORT=5000

# MongoDB Connection String (e.g., mongodb://localhost:27017/bookgenie or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/bookgenie

# JWT Secret for signing stateless authentication tokens (use a strong random string in prod)
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key for AI text generation. Keep this secret!
# You can provide a single key, or a comma-separated list of keys for automatic rate-limit failover
GEMINI_API_KEY=your_gemini_api_key_here,your_second_api_key_here

# Client URL (for CORS configuration, to allow requests only from our frontend)
CLIENT_URL=http://localhost:5173
